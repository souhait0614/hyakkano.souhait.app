---
import { TITLE_SPINOFF } from '@data/meta';

import IconDownload from '@/components/icons/IconDownload.svelte';
import IconList from '@/components/icons/IconList.svelte';
import LinkButton from '@/components/LinkButton.svelte';
import LinkEmail from '@/components/LinkEmail.astro';
import LinkText from '@/components/LinkText.svelte';
import { IME_DICT_METADATA } from '@/constants/page-metadata';
import { SITE_CREATOR_SITE_URL } from '@/constants/site';
import { IME_DICT_FILE_VARIANTS, createImeDictDownloadHref, createImeDictPreviewHref } from '@/features/ime-dict/downloadLinks';
import GenerateOptionsTable from '@/features/ime-dict/GenerateOptionsTable.astro';
import ImeDictForm from '@/features/ime-dict/ImeDictForm.svelte';
import { GENERATE_OPTIONS_COMICS_COMMONS, GENERATE_OPTIONS_YOUNG_JUMP_ALL, getLatestImeDictReleasedData } from '@/features/ime-dict/pageData';
import { formatUpdateLogDate, IME_DICT_UPDATE_LOGS } from '@/features/ime-dict/updateLogs';
import Layout from '@/layouts/Layout.astro';

const latestReleasedData = getLatestImeDictReleasedData();

const updateLogs = [...IME_DICT_UPDATE_LOGS].sort((a, b) => {
  const dateA = new Date(a.date[0], a.date[1] - 1, a.date[2]);
  const dateB = new Date(b.date[0], b.date[1] - 1, b.date[2]);
  return dateB.getTime() - dateA.getTime();
});
---

<Layout metadata={IME_DICT_METADATA}>
  <div class='page-container'>
    <h1 class='page-title'>{IME_DICT_METADATA.title}</h1>
    <section class='flex flex-col gap-2 card'>
      <h2>このページについて</h2>
      <p>キャラクターの名前や一部の用語をユーザー辞書としてインポートできる形式でダウンロードできます。</p>
      <p>Microsoft IME、Google IME(Mozc/Google 日本語入力/Gboard)、Apple IME(macOS)に対応しています。</p>
      <p>ユーザー辞書のインポートが行えない環境(iOSなど)でも辞書の内容を表示することで手動で登録を行うことができます。</p>
    </section>
    <section class='flex flex-col gap-2 card'>
      <h2>更新履歴</h2>
      <ul class='list-inside list-disc'>
        {updateLogs.map((log) => {
          const { dateTime, label } = formatUpdateLogDate(log.date);
          return (
            <li class='grid grid-cols-[auto_1fr] items-baseline gap-2'>
              <time datetime={dateTime} class='text-sm font-bold'>
                {label}
              </time>
              <p class='whitespace-pre-wrap'>{log.description}</p>
            </li>
          );
        })}
      </ul>
      <p class='text-sm'>更新されたファイルを再度インポートすることで更新分のみを取り込むことができます。</p>
      <p class='text-sm'>語句や読みが修正された場合、お手数ですが該当する修正前の登録内容を削除の上、再度インポートしてください。</p>
    </section>
    <section class='flex flex-col gap-2 card'>
      <h2>ダウンロード</h2>
      <p>含まれる用語の範囲や種類が異なるいくつかのバリエーションを用意しています。</p>
      <section class='flex flex-col gap-2 card-outlined'>
        <h3>コミックス{latestReleasedData.comicsVolume}巻までの主要な用語</h3>
        <GenerateOptionsTable generateOptions={GENERATE_OPTIONS_COMICS_COMMONS} />
        <div class={`
          flex flex-row flex-wrap justify-center
          *:w-1/2
          max-sm:*:w-full
        `}
        >
          {IME_DICT_FILE_VARIANTS.map((variant) => (
            <LinkButton
              download
              prefetch={false}
              align='center'
              icon={IconDownload}
              href={createImeDictDownloadHref(variant.path, GENERATE_OPTIONS_COMICS_COMMONS)}
              label={variant.label}
            />
          ))}
          <LinkButton
            prefetch={false}
            align='center'
            icon={IconList}
            to={createImeDictPreviewHref(GENERATE_OPTIONS_COMICS_COMMONS)}
            label='内容を表示'
          />
        </div>
      </section>
      <section class='flex flex-col gap-2 card-outlined'>
        <h3>収録しているすべての用語</h3>
        <table class='block text-sm'>
          <tbody class='contents'>
            <tr class='flex'>
              <th class={`
                block w-min whitespace-nowrap
                after:content-[":"]
              `}
              >本編
              </th>
              <td class='block'>
                {latestReleasedData.youngJumpMainChapter}話
              </td>
            </tr>
            <tr class='flex'>
              <th class={`
                block w-min whitespace-nowrap
                after:content-[":"]
              `}
              >{TITLE_SPINOFF}
              </th>
              <td class='block'>
                {latestReleasedData.youngJumpSpinoffChapter}話
              </td>
            </tr>
          </tbody>
        </table>
        <GenerateOptionsTable generateOptions={GENERATE_OPTIONS_YOUNG_JUMP_ALL} />
        <div class={`
          flex flex-row flex-wrap justify-center
          *:w-1/2
          max-sm:*:w-full
        `}
        >
          {IME_DICT_FILE_VARIANTS.map((variant) => (
            <LinkButton
              download
              prefetch={false}
              align='center'
              icon={IconDownload}
              href={createImeDictDownloadHref(variant.path, GENERATE_OPTIONS_YOUNG_JUMP_ALL)}
              label={variant.label}
            />
          ))}
          <LinkButton
            prefetch={false}
            align='center'
            icon={IconList}
            to={createImeDictPreviewHref(GENERATE_OPTIONS_YOUNG_JUMP_ALL)}
            label='内容を表示'
          />
        </div>
      </section>
    </section>
    <section class='flex flex-col gap-2 card'>
      <h2>用語の範囲と種類を設定してダウンロード</h2>
      <p>手動で用語の範囲や種類を設定してユーザー辞書を生成・ダウンロードできます。</p>
      <p>設定はブラウザに保存され、次回表示時にも反映されます。</p>
      <ImeDictForm
        client:visible
        latestAnimeEpisode={latestReleasedData.animeEpisode}
        latestAnimeSeason={latestReleasedData.animeSeason}
        latestComicsVolume={latestReleasedData.comicsVolume}
        latestJumpPlusMainChapter={latestReleasedData.jumpPlusMainChapter}
        latestJumpPlusSpinoffChapter={latestReleasedData.jumpPlusSpinoffChapter}
        latestYoungJumpMainChapter={latestReleasedData.youngJumpMainChapter}
        latestYoungJumpSpinoffChapter={latestReleasedData.youngJumpSpinoffChapter}
      />
    </section>
    <section class='flex flex-col gap-2 card'>
      <h2>注意事項</h2>
      <section class='contents'>
        <h3>辞書に含まれる用語について</h3>
        <p>漫画版（{TITLE_SPINOFF}含む）およびTVアニメ版に登場するキャラクター名および一部の用語を収録しています。</p>
        <p>キャラクター名は各種媒体で姿と名前の両方が描写されているもののみを収録しています。</p>
        <p>先行で姿のみが描写され、後に名前が描写されたキャラクターについては、姿が描写された話数を登場話数として登録しています。</p>
        <p>公式の情報をもとに作成していますが、誤りが含まれる可能性があります。</p>
        <p>
          辞書内容に関するお問い合わせは、メール（<LinkEmail user='me' domain='souhait.me' />）または
          <LinkText external href={SITE_CREATOR_SITE_URL} label='管理人の各種SNSアカウント' />までお願いします。
        </p>
      </section>
      <section class='contents'>
        <h3>辞書ファイルの利用について</h3>
        <p>辞書ファイルのインポート方法については各IMEの公式ドキュメントなどを参照してください。</p>
        <p>辞書ファイルを利用したことによって生じた問題については責任を負いかねますのでご了承ください。</p>
      </section>
    </section>
  </div>
</Layout>
