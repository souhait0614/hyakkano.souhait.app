    "kiso.css": "1.2.4",
    "lefthook": "2.2.2",
    "stylelint": "18.0.0",
    "stylelint-config-recess-order": "7.10.0",
    "stylelint-config-recommended": "19.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
