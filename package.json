    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "runed": "0.38.0",
    "schummar-translate": "1.27.2",
    "svelte": "5.57.3",
    "tailwind-variants": "4.0.1",
    "valibot": "1.5.0"
